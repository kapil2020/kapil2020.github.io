{
  "name": "kapil2020.github.io",
  "version": "2.0.0",
  "private": true,
  "description": "Academic website of Kapil Kumar Meena: hand-built, no framework.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "test": "node scripts/build.mjs && node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "images": "node scripts/images.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1"
  },
  "engines": {
    "node": ">=20"
  }
}
